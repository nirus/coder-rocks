flowchart TD
    A["User completes a query"] --> B{"Gate Cascade"}

    B -->|"1. Feature flags off"| X1["return (0 cost)"]
    B -->|"2. < 24h since last"| X2["return (1 stat)"]
    B -->|"3. Scan throttle"| X3["return (0 cost)"]
    B -->|"4. < 5 sessions"| X4["return (readdir)"]
    B -->|"5. Lock held"| X5["return"]
    B -->|"All gates pass ✓"| C

    C["Acquire CAS Lock\nWrite PID, verify"] --> D["Fork Agent\nisolated context, shared cache"]

    D --> E["Phase 1: Orient\nls memory, read MEMORY.md"]
    E --> F["Phase 2: Gather\nlogs, grep transcripts"]
    F --> G["Phase 3: Consolidate\nwrite/merge memory files"]
    G --> H["Phase 4: Prune\nindex under 200 lines"]

    H --> I{"Outcome"}
    I -->|"Success"| S["✓ Improved N memories\nlock mtime advances"]
    I -->|"Failure"| FL["✗ Rollback lock\nretry in ~10min"]
    I -->|"User Kill"| K["abort + rollback\ntask marked killed"]

    style A fill:#22272e,stroke:#404040,color:#e5e5e5
    style B fill:#2a2000,stroke:#a08000,color:#e5c34b
    style C fill:#1a1a2e,stroke:#505080,color:#d4d4d4
    style D fill:#1a1a2e,stroke:#505080,color:#d4d4d4
    style E fill:#22272e,stroke:#404040,color:#adbac7
    style F fill:#22272e,stroke:#404040,color:#adbac7
