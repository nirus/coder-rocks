    style H fill:#1a2e1a,stroke:#406040,color:#a0d0a0
    style I fill:#2a2000,stroke:#a08000,color:#e5c34b
    style S fill:#1a2e1a,stroke:#406040,color:#a0d0a0
    style FL fill:#2e1a1a,stroke:#804040,color:#d0a0a0
    style K fill:#2a2000,stroke:#705000,color:#d4b060
    style X1 fill:#171717,stroke:#262626,color:#666666
    style X2 fill:#171717,stroke:#262626,color:#666666
